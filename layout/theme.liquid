<!doctype html>
<html lang="{{ shop.locale.iso_code | default: 'en' }}" class="no-js">
  <head>
    {% render '_meta' %}

    {{ settings.custom_head }}

    {% assign default_favicon = 'favicon.png' | asset_img_url %}
    {% assign dark_favicon = settings.favicon_dark | image_url: width: 64, crop: false %}
    {% assign light_favicon = settings.favicon_light | image_url: width: 64, crop: false %}

    <link
      rel="icon"
      type="image/png"
      media="(prefers-color-scheme: light)"
      href="{{ dark_favicon | default: default_favicon }}"
    >

    <link
      rel="icon"
      type="image/png"
      media="(prefers-color-scheme: dark)"
      href="{{ light_favicon | default: default_favicon }}"
    >

    {% render '_font' %}

    {{ 'theme.css' | asset_url | stylesheet_tag: preload: true }}
    <script src="{{ 'theme.js' | asset_url }}" type="module"></script>

    <script>
      document.documentElement.classList.remove('no-js')
    </script>

    {{ content_for_header }}
  </head>

  <body>
    {% render 'skip-link' %}

    {% sections 'header-group' %}

    {% render 'cart-notification' %}

    <main id="main" role="main">
      <div>
        {{ content_for_layout }}
      </div>

      {% sections 'footer-group' %}
    </main>
  </body>
</html>
