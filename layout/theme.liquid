<!doctype html>
{% # theme-check-disable-next-line ValidScopedCSSClass %}
<html lang="{{ shop.locale.iso_code }}" class="no-js">
  <head>
    {% render 'head' %}

    {{ settings.custom_head }}

    {% render 'favicon' %}

    {% render 'fonts' %}

    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    <script src="{{ 'theme.js' | asset_url }}" type="module" crossorigin="anonymous"></script>

    <script>
      document.documentElement.classList.remove('no-js')
    </script>

    {{ content_for_header }}
  </head>

  <body hx-ext="morph, loading-states, preload" class="grid min-h-screen grid-rows-[auto_1fr] overflow-x-clip">
    {% render 'skip-to-content-link' %}

    <section
      x-data="{ translated: false }"
      @announcement-bar:visible.window="value => translated = !value.detail"
      class="sticky top-0 z-10 w-screen transition-transform"
      :class="translated ? '-translate-y-(--announcement-bar-height)' : ''"
    >
      {% sections 'header-group' %}
    </section>

    {% render 'cart-notification' %}

    <main
      id="swup"
      role="main"
      class="grid min-h-[calc(100vh-var(--header-height)-var(--announcement-bar-height))] grid-rows-[1fr_auto]"
    >
      <div id="content" class="contents">
        <div>
          {{ content_for_layout }}
        </div>

        {% sections 'footer-group' %}
      </div>
    </main>
  </body>
</html>
