{% doc %}
  Outputs a menu button and a full-screen `<dialog>` that slides in from the left.
  Contains navigation links. The active link gets `aria-current="page"`, set from the current path.

  @example
  {% content_for 'block', type: '_mobile-menu', id: 'mobile_menu' %}
{% enddoc %}

<button class="button ghost" onclick="document.getElementById('mobile_menu')?.showModal()">Menu</button>

<dialog
  scroll-lock
  id="mobile_menu"
  closedby="any"
  class="drawer menu-dialog"
  data-position="left"
>
  <article>
    <header>
      <p>Menu</p>

      <form method="dialog">
        <button aria-title="Close mobile menu" class="button ghost square">
          {% render 'icon', name: 'cross' %}
        </button>
      </form>
    </header>

    <nav>
      <a
        class="button ghost"
        href="{{ routes.collections_url }}"
        {% if request.path contains routes.collections_url %}
          aria-current="page"
        {% endif %}
      >
        Shop
      </a>

      {% render 'account-link' %}
    </nav>
  </article>
</dialog>

{% stylesheet %}
  .mobile-menu {
    dialog {
    }

    article {
      header {
        justify-content: space-between;
      }

      nav {
        display: grid;
        gap: 1rem;
        justify-items: baseline;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mobile menu",
  "class": "mobile-menu",
  "presets": [
    {
      "name": "Mobile menu"
    }
  ]
}
{% endschema %}
