{% doc %}
  Outputs a cart icon link and a slide-in `<dialog>` from the right showing the cart contents.
  Clicking the link opens the drawer instead of navigating to the cart page.
  Cart items are rendered by the `cart-form` snippet.
  The cart item count (`#cart_amount`) is updated when products are added via htmx.

  @example
  {% content_for 'block', type: '_cart-drawer', id: 'cart_drawer' %}
{% enddoc %}

<a
  href="{{ routes.cart_url }}"
  x-data="{ active: {% if request.path == '{{ routes.cart_url }}' %}true{% else %}false{% endif %} }"
  @window:navigation.window="active = location.pathname === '{{ routes.cart_url }}'"
  onclick="event.preventDefault(); event.stopPropagation(); document.getElementById('cart_drawer')?.showModal()"
  :aria-current="active ? 'page' : false"
  class="button ghost"
>
  Cart
  <span
    >(<span id="cart_amount">{{- cart.item_count -}}</span>)</span
  >
</a>

<dialog
  scroll-lock
  id="cart_drawer"
  closedby="any"
  class="cart-drawer"
  style="view-transition-name: cart-drawer"
>
  <article id="cart_drawer_content">
    <header>
      <p>
        Your cart (
        {{- cart.item_count -}}
        )
      </p>

      <form method="dialog">
        <button aria-title="Close cart drawer" class="button ghost square">
          {% render 'icon-cross' %}
        </button>
      </form>
    </header>

    {% render 'cart-form' %}
  </article>
</dialog>

{% stylesheet %}
  .cart-drawer {
    inset: 1rem 1rem 1rem auto;
    width: 100%;
    max-width: 28rem;
    height: var(--vvh);
    overflow: auto;
    overscroll-behavior: contain;

    & > article {
      display: grid;
      grid-template-rows: auto 1fr;
      height: 100%;

      & > header {
        position: sticky;
        top: 0;
        z-index: 1;
        justify-content: space-between;
        background-color: var(--jazz-background-color);

        & > form {
          display: contents;
        }
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart drawer",
  "presets": [
    {
      "name": "Cart drawer"
    }
  ]
}
{% endschema %}
