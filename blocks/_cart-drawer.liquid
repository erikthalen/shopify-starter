{% doc %}
  Outputs a cart icon link and a slide-in `<dialog>` from the right showing the cart contents.
  Clicking the link opens the drawer instead of navigating to the cart page.
  Cart items are rendered by the `cart-form` snippet.
  The cart item count (`#cart_amount`) is updated when products are added via htmx.

  @example
  {% content_for 'block', type: '_cart-drawer', id: 'cart_drawer' %}
{% enddoc %}

<div id="cart_drawer">
  <a
    href="{{ routes.cart_url }}"
    onclick="event.preventDefault(); event.stopPropagation(); document.getElementById('cart_drawer_dialog')?.showModal()"
    class="button ghost"
    {% if request.path == routes.cart_url %}
      aria-current="page"
    {% endif %}
  >
    <span class="desktop-only">Cart</span>
    <span class="mobile-only">{% render 'icon', name: 'basket' %}</span>

    (
    {{- cart.item_count -}}
    )
  </a>

  <dialog
    id="cart_drawer_dialog"
    scroll-lock
    closedby="any"
    class="drawer"
  >
    <article class="drawer-content">
      <header>
        <span>
          Your cart (
          {{- cart.item_count -}}
          )
        </span>

        <form method="dialog" class="contents">
          <button aria-title="Close cart drawer" class="button ghost square">
            {% render 'icon', name: 'cross' %}
          </button>
        </form>
      </header>

      {%- if cart == empty -%}
        <div class="empty cart-empty">
          {% render 'icon', name: 'basket' %}

          <h2>Your cart is empty</h2>
          <a href="{{ routes.collections_url }}" class="button"> Go to shop </a>
        </div>
      {%- else -%}
        <ul class="cart-items">
          {%- for item in cart.items -%}
            {% render 'cart-item', item: item %}
          {%- endfor -%}
        </ul>

        <footer>
          <div class="cart-total">
            <p>Total: {{ cart.total_price | money_with_currency }}</p>

            {% form 'cart', cart %}
              <button type="submit" name="checkout">Checkout</button>
            {% endform %}
          </div>

          <a href="{{ routes.cart_url }}" class="button ghost"> Go to cart </a>
        </footer>
      {%- endif -%}
    </article>
  </dialog>
</div>

{% stylesheet %}
  .cart-drawer {
    .drawer-content {
      display: grid;
      grid-template-rows: auto 1fr auto;
      height: 100%;

      > header {
        z-index: 1;

        position: sticky;
        top: 0;

        justify-content: space-between;
      }

      > footer {
        z-index: 1;

        position: sticky;
        bottom: 0;

        display: grid;
      }
    }

    .cart-empty {
      margin: auto;
    }

    .cart-items {
      display: grid;
      align-content: baseline;
      gap: 0.5rem;

      overflow: auto;
      overscroll-behavior: contain;
    }

    .cart-total {
      display: flex;
      justify-content: space-between;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart drawer",
  "class": "cart-drawer",
  "presets": [
    {
      "name": "Cart drawer"
    }
  ]
}
{% endschema %}
