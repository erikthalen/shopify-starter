{% comment %} simple login field, during development {% endcomment %}

<div id="login" class="password-login">
  <form
    method="post"
    action="/password"
    id="login_form"
    accept-charset="UTF-8"
  >
    <input type="hidden" name="form_type" value="storefront_password">
    <input type="hidden" name="utf8" value="✓">

    <label for="password">
      Enter store using password:<br>

      <input
        placeholder="password"
        type="password"
        name="password"
        id="password"
        autofocus=""
      >
    </label>

    <div class="actions">
      <input class="button" name="commit" type="submit" value="Enter">
    </div>
  </form>
</div>
