{
  "name": "shopify-starter",
  "version": "3.0.0",
  "private": true,
  "author": {
    "name": "Erik Thalén",
    "url": "https://github.com/erikthalen"
  },
  "repository": "github:erikthalen/shopify-starter",
  "type": "module",
  "scripts": {
    "dev": "pnpm run watch & pnpm run shopify:dev",
    "deploy": "pnpm run build && pnpm run shopify:deploy",
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "shopify:dev": "shopify theme dev -e development --open",
    "shopify:deploy": "shopify theme push -e development && shopify theme push -e production",
    "prettier": "prettier . --write"
  },
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "^1.5.2",
    "@types/alpinejs": "^3.13.11",
    "@types/alpinejs__intersect": "^3.13.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.3.3"
  },
  "dependencies": {
    "@alpinejs/intersect": "^3.14.9",
    "@swup/a11y-plugin": "^5.0.0",
    "@swup/debug-plugin": "^4.1.0",
    "@swup/preload-plugin": "^3.2.11",
    "alpinejs": "3.15.11",
    "embla-carousel": "^8.6.0",
    "htmx.org": "^4.0.0",
    "swup": "4.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": false,
    "arrowParens": "avoid",
    "plugins": [
      "@shopify/prettier-plugin-liquid"
    ]
  }
}
