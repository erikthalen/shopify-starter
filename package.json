{
  "name": "shopify-starter",
  "version": "3.0.0",
  "private": true,
  "author": {
    "name": "Erik Thalén",
    "url": "https://github.com/erikthalen"
  },
  "repository": "github:erikthalen/shopify-starter",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.js --watch & shopify theme dev -e development --open",
    "deploy": "node esbuild.config.js && shopify theme push -e production",
    "docs": "pnpm erikt-ui docs",
    "prettier": "prettier . --write"
  },
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "1.10.2",
    "esbuild": "0.28.2",
    "prettier": "3.8.3"
  },
  "dependencies": {
    "@blossom-carousel/web": "1.6.0",
    "@erikt/ui": "0.0.44",
    "@videojs/html": "10.2.0",
    "dialog-closedby-polyfill": "1.3.0",
    "htmx.org": "4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": false,
    "arrowParens": "avoid",
    "plugins": [
      "@shopify/prettier-plugin-liquid"
    ]
  }
}
