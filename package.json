{
  "name": "shopify-starter",
  "version": "3.0.0",
  "private": true,
  "author": {
    "name": "Erik Thalén",
    "url": "https://github.com/erikthalen"
  },
  "repository": "github:erikthalen/shopify-starter",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.js --watch & shopify theme dev -e development --open",
    "deploy": "node esbuild.config.js && shopify theme push -e production",
    "docs": "pnpm erikt-ui docs",
    "prettier": "prettier . --write"
  },
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "^1.5.2",
    "@types/alpinejs": "^3.13.11",
    "@types/alpinejs__intersect": "^3.13.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.3.3"
  },
  "dependencies": {
    "@alpinejs/intersect": "^3.14.9",
    "@blossom-carousel/web": "^1.6.0",
    "@erikt/ui": "^0.0.43",
    "@videojs/html": "^10.2.0",
    "alpinejs": "3.15.11",
    "htmx.org": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": false,
    "arrowParens": "avoid",
    "plugins": [
      "@shopify/prettier-plugin-liquid"
    ]
  }
}
