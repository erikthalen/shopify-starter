{
  "name": "shopify-starter",
  "version": "1.0.0",
  "private": true,
  "author": {
    "name": "Erik Thalén",
    "url": "https://github.com/erikthalen"
  },
  "repository": "github:erikthalen/shopify-starter",
  "engines": {
    "node": ">=23"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm run shopify:dev & pnpm run esbuild:dev & pnpm run css:dev",
    "build": "pnpm run esbuild:build && pnpm run css:build",
    "deploy": "pnpm run build && pnpm run shopify:deploy",
    "esbuild:build": "node esbuild.config.ts",
    "esbuild:dev": "node --watch --watch-path=src esbuild.config.ts",
    "css:build": "tailwindcss -i src/theme.css -o assets/theme.css --minify",
    "css:dev": "tailwindcss -i src/theme.css -o assets/theme.css --watch",
    "shopify:dev": "shopify theme dev -e development --open",
    "shopify:deploy": "shopify theme push -e development && shopify theme push -e production",
    "prettier": "prettier . --write"
  },
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "^1.5.2",
    "@tailwindcss/cli": "^4.3.0",
    "@types/alpinejs": "^3.13.11",
    "@types/alpinejs__intersect": "^3.13.4",
    "esbuild": "0.28.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "4.2.2"
  },
  "dependencies": {
    "@alpinejs/intersect": "^3.14.9",
    "@swup/a11y-plugin": "^5.0.0",
    "@swup/preload-plugin": "^3.2.11",
    "alpinejs": "3.15.11",
    "embla-carousel": "^8.6.0",
    "htmx-ext-preload": "^2.1.2",
    "htmx.org": "^2.0.8",
    "idiomorph": "^0.7.4",
    "swup": "4.8.3"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": false,
    "arrowParens": "avoid",
    "plugins": [
      "@shopify/prettier-plugin-liquid",
      "prettier-plugin-tailwindcss"
    ]
  }
}
