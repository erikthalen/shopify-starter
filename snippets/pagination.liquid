{% doc %}
  Outputs a standard previous/next and numbered pagination nav.
  Only renders when there is more than one page. The current page is underlined.
  Use this as a fallback or alternative to the `infinite-scroll` snippet.

  @param {object} paginate - Shopify `paginate` object.

  @example
  {% paginate collection.products by 12 %}
    <ol>
      {% for product in collection.products %}
        <li>{{ product.title }}</li>
      {% endfor %}
    </ol>

    {% render 'pagination', paginate: paginate %}
  {% endpaginate %}
{% enddoc %}

{%- if paginate.pages > 1 -%}
  <nav role="navigation" aria-label="Pagination" class="pagination">
    <ol>
      {%- if paginate.previous -%}
        <li>
          <a href="{{ paginate.previous.url }}" class="button ghost"> Previous <span class="sr-only">page</span> </a>
        </li>
      {%- else -%}
        <li class="button ghost" aria-disabled="true">Previous <span class="sr-only">page</span></li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <li>
            <a href="{{ part.url }}" class="button ghost square">
              <span class="sr-only">page</span> {{ part.title }}
            </a>
          </li>
        {%- else -%}
          {%- if part.title == paginate.current_page -%}
            <li class="button ghost square" aria-disabled="true" aria-current="page">
              <span class="sr-only">page</span> {{ part.title }}
            </li>
          {%- else -%}
            <li class="button ghost square" aria-disabled="true"><span class="sr-only">page</span> {{ part.title }}</li>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if paginate.next -%}
        <li>
          <a href="{{ paginate.next.url }}" class="button ghost"> Next <span class="sr-only">page</span> </a>
        </li>
      {%- else -%}
        <li class="button ghost" aria-disabled="true">Next <span class="sr-only">page</span></li>
      {%- endif -%}
    </ol>
  </nav>
{%- endif -%}

{% stylesheet %}
  .pagination {
    display: flex;
    justify-content: center;
    margin-top: 5rem;

    ol {
      display: flex;
      gap: 1rem;
    }

    & li:not(:has(button, .button)) {
      color: currentColor;
    }
  }
{% endstylesheet %}
