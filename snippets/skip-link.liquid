<a class="button skip-link" href="#main"> Skip to content </a>

{% stylesheet %}
  .skip-link {
    z-index: 100;

    position: fixed;
    top: 1.5rem;
    left: 50%;

    padding: 0.5rem 1rem;

    outline: 2px solid oklch(62.3% 0.214 259.815);
    border-radius: 0.5rem;
    background-color: var(--ui-background-color);
    opacity: 0;

    translate: -50% -50%;

    pointer-events: none;

    &:focus {
      opacity: 1;
      pointer-events: auto;
    }
  }
{% endstylesheet %}
