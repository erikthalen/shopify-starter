{% doc %}
  Outputs a product card with image, title, price, and a quick-buy button.
  Renders the `product-price` and `quick-buy` snippets internally.

  @param {object} product - Shopify `product` object.

  @example
  {% render 'product-card', product: product %}
{% enddoc %}

<div
  class="product-card"
  style="view-transition-name: product-card-{{ product.selected_or_first_available_variant.id }}"
>
  {% if product.selected_or_first_available_variant.featured_image != blank %}
    {% render 'image',
      image: product.selected_or_first_available_variant.featured_image,
      sizes: '50vw, 20vw',
      class: 'product-card__image'
    %}
  {% else %}
    {% render 'image', image: product.featured_image, sizes: '50vw, 20vw', class: 'product-card__image' %}
  {% endif %}

  <a href="{{ product.url }}" class="product-card__link">
    {{ product.title }}
  </a>

  {% render 'product-price', product: product %}

  {% render 'quick-buy', product: product %}
</div>

{% stylesheet %}
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .product-card__image {
    border-radius: 0.25rem;
  }

  /* make the whole card clickable */
  .product-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
{% endstylesheet %}
