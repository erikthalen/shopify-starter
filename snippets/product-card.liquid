{% doc %}
  Outputs a product card with image, title, price, and a quick-buy button.
  Renders the `product-price` and `quick-buy` snippets internally.

  @param {object} product - Shopify `product` object.

  @example
  {% render 'product-card', product: product %}
{% enddoc %}

{% assign variant = product.selected_or_first_available_variant %}

<div
  class="product-card"
  style="--view-transition-name: product-card-{{ variant.id }}"
>
  {% if variant.featured_image != blank %}
    {% render 'image', image: variant.featured_image, sizes: '50vw, 20vw', class: 'card-image' %}
  {% else %}
    {% render 'image', image: product.featured_image, sizes: '50vw, 20vw', class: 'card-image' %}
  {% endif %}

  <a href="{{ product.url }}">
    {{ product.title }}
  </a>

  {% render 'product-price', variant: variant %}

  {% render 'quick-buy', variant: variant %}
</div>

{% stylesheet %}
  .product-card {
    isolation: isolate;

    position: relative;
    display: grid;
    justify-items: baseline;
    gap: 0.75rem;

    .card-image {
      border-radius: 0.25rem;
    }

    /* make the whole card clickable */
    a {
      &::before {
        position: absolute;
        inset: 0;
        content: '';
      }
    }

    .quick-buy {
      z-index: 1;
    }
  }
{% endstylesheet %}
