{% doc %}
  Outputs a video with controls.

  @param {video} video - Shopify `video` object.
  @param {image} [poster] - Poster image, defaults to the video's poster.
  @param {string} [aspect_ratio] - CSS `aspect-ratio` value, e.g. `16/9`.
  @param {string} [aspect_ratio_sm] - Aspect ratio on small screens. Overrides `aspect_ratio`.
  @param {string} [aspect_ratio_md] - Aspect ratio on large screens. Overrides `aspect_ratio`.
  @param {string} [class] - Additional css classes.

  @example
  {% render 'video', video: section.settings.video, aspect_ratio: '16/9' %}

  {% render 'video',
    video: section.settings.video,
    aspect_ratio_sm: '1/1',
    aspect_ratio_md: '16/9'
  %}
{% enddoc %}

{% liquid
  assign poster = poster | default: video.preview_image

  assign default_aspect_ratio = video.aspect_ratio | append: '/1'
  assign ar_sm = aspect_ratio_sm | default: aspect_ratio | default: default_aspect_ratio
  assign ar_md = aspect_ratio_md | default: aspect_ratio | default: default_aspect_ratio

  assign aspect_ratio_css = '--aspect-ratio-sm:' | append: ar_sm | append: '; --aspect-ratio-md:' | append: ar_md | append: ';'
%}

{% if video != blank %}
  <script defer src="{{ 'video.js' | asset_url }}"></script>

  <video-player
    class="video-player{% if class %} {{ class }}{% endif %}"
    style="{{ aspect_ratio_css }}"
  >
    <video-skin>
      <video playsinline>
        {% for source in video.sources %}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {% endfor %}
      </video>

      {% render 'image',
        image: poster,
        aspect_ratio: aspect_ratio,
        sizes: '100vw, 100vw',
        loading: 'eager',
        alt: video.alt,
        slot: 'poster',
        class: 'video-poster'
      %}

      <media-play-button>
        <span class="play-label"> Play </span>

        {% comment %}
          <span class="pause-label">Pause</span>
          <span class="replay-label">Replay</span>
        {% endcomment %}
      </media-play-button>
    </video-skin>
  </video-player>
{% endif %}

{% stylesheet %}
  .video-player {
    --media-border-radius: 0px;

    font-weight: 700;
    user-select: none;

    video-skin {
      position: relative;
      width: 100%;
    }

    video {
      aspect-ratio: var(--aspect-ratio-sm);

      @media (width >= 48rem) {
        aspect-ratio: var(--aspect-ratio-md);
      }
    }

    /* The skin's own poster positions and fades the slot; size the image within it */
    .video-poster {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    media-play-button {
      z-index: 12;

      position: absolute;
      inset: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      color: var(--scheme-text, var(--color-white));

      cursor: pointer;
      pointer-events: none;

      /* Paused (but not ended) */
      &[data-paused]:not([data-ended]) {
        pointer-events: auto;

        .play-label {
          opacity: 1;
          scale: 1;
          filter: blur(0);
          pointer-events: auto;
          transition-delay: 1000ms;
        }
      }

      /* Playing */
      &:not([data-paused]) {
        .pause-label {
          opacity: 1;
          scale: 1;
          filter: blur(0);
          pointer-events: auto;
        }
      }

      /* Ended */
      &[data-ended] {
        .replay-label {
          opacity: 1;
          scale: 1;
          filter: blur(0);
          pointer-events: auto;
        }
      }

      /* Default state */
      span {
        display: flex;

        padding: 0.5rem 1.5rem;

        border-radius: 100px;
        background-color: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        opacity: 0;
        filter: blur(4px);

        scale: 1.05;

        will-change: transform;
        transition: all 200ms var(--ease-glide);

        pointer-events: none;
      }
    }
  }
{% endstylesheet %}
