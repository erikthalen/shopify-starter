{% doc %}
  Outputs a full product form including a variant picker, quantity selector, add-to-cart button,
  and Shopify payment button. Shows a striped loading animation on the button while the cart request is pending.
{% enddoc %}

{% assign variant = product.selected_or_first_available_variant %}

{% form 'product',
  product,
  class: 'product-form',
  hx-post: routes.cart_add_url,
  hx-select: '#cart_drawer',
  hx-target: '#cart_drawer',
  hx-swap: 'outerMorph',
  hx-select-oob: '#cart_section',
  data-loading-states: ''
%}
  <input id="variant_id" type="hidden" name="id" value="{{ variant.id }}">

  <fieldset>
    {% comment %} {% assign amount_in_cart = cart.items | where: 'id', product.selected_or_first_available_variant.id | map: 'quantity' | sum %} {% endcomment %}

    {% render 'quantity-selector', min: 1, name: 'quantity', value: 1, id: 'product', attr: 'hx-preserve' %}

    <button
      class="add-to-cart"
      data-loading-aria-busy
      type="submit"
      name="add"
      {% unless variant.available %}
        disabled
      {% endunless %}
    >
      {% if variant.available %}
        Add to cart
      {% else %}
        Notify me
      {% endif %}
    </button>
  </fieldset>

  <div id="shopify_payment_button">
    {{ form | payment_button }}
  </div>
{% endform %}

{% stylesheet %}
  .product-form {
    fieldset {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-block: 1.5rem;
    }
  }
{% endstylesheet %}
