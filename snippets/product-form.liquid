{% doc %}
  Outputs a full product form including a variant picker, quantity selector, add-to-cart button,
  and Shopify payment button. Shows a striped loading animation on the button while the cart request is pending.
{% enddoc %}

{% assign variant = product.selected_or_first_available_variant %}

{% render 'variant-picker' %}

{% form 'product',
  product,
  class: 'product-form',
  hx-post: routes.cart_add_url,
  hx-select: '#cart_drawer_content',
  hx-target: '#cart_drawer_content',
  hx-swap: 'outerHTML',
  hx-select-oob: '#cart_amount',
  data-loading-states: ''
%}
  <input id="variant_id" type="hidden" name="id" value="{{ variant.id }}">

  <fieldset>
    {% render 'quantity-selector', min: 1, name: 'quantity', value: 1, id: 'product', attr: 'hx-preserve' %}

    <button
      data-loading-aria-busy
      type="submit"
      name="add"
      {% unless variant.available %}
        disabled
      {% endunless %}
    >
      {% if variant.available %}
        Add to cart
      {% else %}
        Notify me
      {% endif %}
    </button>
  </fieldset>

  <div id="shopify_payment_button">
    {{ form | payment_button }}
  </div>
{% endform %}

{% stylesheet %}
  .product-form {
    width: 100%;
    margin-block: 1rem;

    & > fieldset {
      display: flex;
      gap: 1rem;
      margin-block: 1.5rem;

      & > button {
        width: 100%;
      }
    }

    & #shopify_payment_button {
      color: oklch(44.6% 0.03 256.802);
    }
  }
{% endstylesheet %}
