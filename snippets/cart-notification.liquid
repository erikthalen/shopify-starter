{% doc %}
  Outputs a slide-down notification `<dialog>` that appears in the top-right corner when a product is added to the cart.
  The dialog content is loaded from the `cart-notification-content` section via AJAX.
  Closing it (e.g. clicking outside) is handled by `closedby="any"`.
  The open/close logic is defined as an [Alpine.js](https://alpinejs.dev/) component in `cart-notification.ts`.

  @example
  {% render 'cart-notification' %}
{% enddoc %}

{% comment %}
  x-data stays on the dialog: cart-notification.ts writes the fetched content into `$root` and calls `show()` on it.
{% endcomment %}
<div class="cart-notification">
  <dialog
    id="cart_notification"
    x-data="cartNotification"
    class="notification-dialog"
    closedby="any"
    style="view-transition-name: cart-notification"
  ></dialog>

  {% comment %} backdrop {% endcomment %}
  <div
    class="notification-backdrop"
    style="view-transition-name: cart-notification-backdrop"
  ></div>
</div>

{% stylesheet %}
  .cart-notification {
    /* only groups the dialog and backdrop, so it doesn't take a row in the body grid */
    display: contents;

    &:has(.notification-dialog[open]) {
      .notification-backdrop {
        display: block;
        opacity: 1;

        @starting-style {
          opacity: 0;
        }
      }
    }

    .notification-dialog {
      z-index: 11;

      position: fixed;
      inset: 3.5rem 1rem auto auto;

      width: 100%;
      max-width: calc(100vw - 2rem);

      @media (width >= 48rem) {
        max-width: 28rem;
      }
    }

    .notification-backdrop {
      --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);

      z-index: 8;

      position: fixed;
      inset: 0 auto auto 0;

      display: none;

      width: 100vw;
      height: 100vh;

      background-color: rgb(0 0 0 / 25%);
      backdrop-filter: blur(2px);
      opacity: 0;
      transition:
        opacity 500ms var(--ease-in-out),
        display 500ms var(--ease-in-out) allow-discrete;
    }
  }
{% endstylesheet %}
