{%- doc -%}
  Renders an inline SVG icon.

  @param {string} name - cross, magnifier, chevron-down, chevron-left, chevron-right, minus, plus, cart, forbid, github
  @param {string} [class] - Extra classes on the svg
  @param {string} [attr] - Extra HTML attributes on the svg

  @example
  {% render 'icon', name: 'cross' %}

  {% render 'icon', name: 'chevron-down', attr: 'x-show="open"' %}
{%- enddoc -%}

{%- case name -%}
  {%- when 'cross' -%}
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      {% if class != blank %}
        class="{{ class }}"
      {% endif %}
      {{ attr }}
    >
      <path vector-effect="non-scaling-stroke" d="M18 6l-12 12" />
      <path vector-effect="non-scaling-stroke" d="M6 6l12 12" />
    </svg>
  {%- when 'magnifier' -%}
    <svg
      xmlns="http://www.w3.org/2000/svg"
