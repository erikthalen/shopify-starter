{%- if cart == empty -%}
  <div id="cart_form" class="empty cart-form-empty">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="icon icon-tabler icons-tabler-outline icon-tabler-garden-cart"
    >
      <path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M15 17.5a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0 -5 0" /><path d="M6 8v11a1 1 0 0 0 1.806 .591l3.694 -5.091v.055" /><path d="M6 8h15l-3.5 7l-7.1 -.747a4 4 0 0 1 -3.296 -2.493l-2.853 -7.13a1 1 0 0 0 -.928 -.63h-1.323" />
    </svg>

    <h2>Your cart is empty</h2>
    <a href="{{ routes.collections_url }}" class="button"> Go to shop </a>
  </div>
{%- else -%}
  <div class="cart-form">
    <ul>
      {%- for item in cart.items -%}
        <li
          style="view-transition-name: cart-item-{{section.id | handleize}}-{{ item.key | handleize }}"
          class="cart-form__item"
        >
          {%- if item.image -%}
            {% render 'image', image: item.image, class: 'cart-form__image', sizes: '100px, 100px' %}
          {%- endif -%}

          <div class="cart-form__details">
            <div class="cart-form__heading">
              <a href="{{ item.url }}">{{ item.product.title | escape }}</a>

              <div
                class="cart-form__price"
                id="cart_item_price_{{ item.key | handleize }}"
              >
                {% comment %} per item price {% endcomment %}
                {% comment %}
                  {%- if item.original_price != item.final_price -%}
                    <p>
                      <s>{{ item.original_price | money -}}</s>
                    </p>
                    <p>{{ item.final_price | money -}}</p>
                  {%- else -%}
                    <p>{{ item.original_price | money }}</p>
                  {%- endif -%}
                {% endcomment %}

                {% comment %} multiple items price {% endcomment %}
                <div>
                  {%- if item.original_line_price != item.final_line_price -%}
                    <p>
                      <s>{{ item.original_line_price | money }}</s>
                    </p>
                    <p>{{ item.final_line_price | money }}</p>
                  {%- else -%}
                    <p>{{ item.original_line_price | money }}</p>
                  {%- endif -%}

                  {%- if item.variant.available and item.unit_price_measurement -%}
                    {{ item.unit_price | money }}

                    {%- if item.unit_price_measurement.reference_value != 1 -%}
                      {{- item.unit_price_measurement.reference_value -}}
                    {%- endif -%}

                    {{ item.unit_price_measurement.reference_unit }}
                  {%- endif -%}
                </div>
              </div>
            </div>

            <dl class="cart-form__options">
              {%- if item.product.has_only_default_variant == false -%}
                {%- for option in item.options_with_values -%}
                  <dt class="cart-form__option-name">{{ option.name }}:</dt>
                  <dd>{{ option.value }}</dd>
                {%- endfor -%}
              {%- endif -%}

              {%- for property in item.properties -%}
                {%- assign property_first_char = property.first | slice: 0 -%}
                {%- if property.last != blank and property_first_char != '_' -%}
                  <dt>{{ property.first }}:</dt>
                  <dd>
                    {%- if property.last contains '/uploads/' -%}
                      <a href="{{ property.last }}" class="link" target="_blank">
                        {{ property.last | split: '/' | last }}
                      </a>
                    {%- else -%}
                      {{ property.last }}
                    {%- endif -%}
                  </dd>
                {%- endif -%}
              {%- endfor -%}
            </dl>

            {{ item.selling_plan_allocation.selling_plan.name }}

            {%- for discount in item.line_level_discount_allocations -%}
              {{ discount.discount_application.title }}
            {%- endfor -%}

            <div class="cart-form__actions">
              <div>
                <form
                  method="post"
                  action="{{ routes.cart_change_url }}"
                  hx-post="{{ routes.cart_change_url }}"
                  hx-select="#cart_drawer_content"
                  hx-target="#cart_drawer_content"
                  hx-swap="outerHTML"
                  hx-sync="this:replace"
                  hx-select-oob="#cart_amount,#cart:outerHTML"
                  data-loading-states
                  data-loading-target="#cart_item_price_{{ item.key | handleize }}"
                  data-loading-aria-busy
                >
                  <input type="hidden" name="id" value="{{ item.key }}">

                  {% assign id = item.key | append: section.id %}

                  {% render 'quantity-selector',
                    min: 0,
                    name: 'quantity',
                    value: item.quantity,
                    on-change: '$el.form.requestSubmit()',
                    id: id
                  %}
                </form>

                <a
                  hx-post="{{ item.url_to_remove }}"
                  hx-select="#cart_drawer_content"
                  hx-target="#cart_drawer_content"
                  hx-swap="outerHTML"
                  hx-select-oob="#cart_amount,#cart:outerHTML"
                  data-loading-states
                  data-loading-aria-busy
                  class="button link"
                  href="{{ item.url_to_remove }}"
                >
                  Remove
                </a>
              </div>
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>

    <div class="cart-form__summary">
      <p>Total: {{ cart.total_price | money_with_currency }}</p>

      {% form 'cart', cart %}
        <button type="submit" name="checkout">Checkout</button>
      {% endform %}
    </div>
  </div>

  <footer class="cart-form-footer">
    <a href="{{ routes.cart_url }}" class="button ghost"> Go to cart </a>
  </footer>
{%- endif -%}

{% stylesheet %}
  .cart-form-empty {
    margin-top: 0;
  }

  .cart-form {
    display: flex;
    flex-direction: column;
  }

  .cart-form__item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding-bottom: 1rem;
    overflow: clip;

    &:not(:last-of-type) {
      margin-bottom: 1rem;
      border-bottom: 1px solid var(--jazz-neutral-200);
    }
  }

  .cart-form__image {
    width: 7.5rem;
    border-radius: 0.25rem;
    overflow: hidden;
  }

  .cart-form__details {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .cart-form__heading {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.25rem;
  }

  .cart-form__price {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-align: right;
  }

  .cart-form__options {
    display: inline-grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.5rem;
    width: fit-content;
  }

  .cart-form__option-name {
    color: oklch(70.7% 0.022 261.325);
  }

  .cart-form__actions {
    margin-top: auto;

    & > div {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1rem;
      margin-top: 0.75rem;
    }

    & form {
      display: contents;
    }

    & .link {
      margin-right: -0.5rem;
    }
  }

  .cart-form__summary {
    display: grid;
    width: 100%;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--jazz-neutral-200);
    background-color: var(--jazz-background-color);

    & > p {
      text-align: right;
    }

    & button {
      width: 100%;
      margin-top: 1rem;
    }
  }

  .cart-form-footer {
    justify-content: center;
  }
{% endstylesheet %}
