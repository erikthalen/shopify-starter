{% doc %}
  Renders all product options as links. Clicking a value fetches the corresponding variant URL
  and swaps `#product_content` in place via htmx, updating the URL without a history entry.
  Unavailable variants are shown with a strikethrough diagonal line.

  @example
  {% render 'variant-picker' %}

  {% form 'product' %}
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
    <input type="hidden" name="quantity" value="1">
    <button>Add to cart</button>
  {% endform %}
{% enddoc %}

{% unless product.has_only_default_variant %}
  <section id="variant_picker" class="variant-picker">
    {%- for option in product.options_with_values -%}
      <fieldset>
        <legend>{{ option.name }}</legend>

        <ul>
          {%- for option_value in option.values -%}
            <li>
              {% assign variants = product.variants %}

              {% comment %} get url to this option's variant, given what's selected of the other options {% endcomment %}
              {%- for other_option in product.options_with_values -%}
                {% if other_option.name == option.name %}
                  {% assign option_key = 'option' | append: option.position %}
                  {% assign variants = variants | where: option_key, option_value.name %}
                {% else %}
                  {% assign option_key = 'option' | append: other_option.position %}
                  {% assign variants = variants | where: option_key, other_option.selected_value %}
                {% endif %}
              {% endfor %}

              <a
                hx-preload="htmx:after:init timeout:60s"
                hx-get="{{ product.url }}?variant={{ variants.first.id }}"
                hx-target="#product_content"
                hx-select="#product_content"
                hx-swap="outerMorph"
                hx-replace-url="true"
                class="button {% if option_value.selected %}secondary{% else %}outlined{% endif %}"
                href="{{ product.url }}?variant={{ variants.first.id }}"
                data-loading-states
                {% if option_value.selected %}
                  aria-current="true"
                {% endif %}
                {% unless option_value.available %}
                  disabled="true"
                {% endunless %}
              >
                {{ option_value -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </fieldset>
    {%- endfor -%}
  </section>
{% endunless %}

{% stylesheet %}
  .variant-picker {
    display: grid;
    gap: 1rem;

    legend {
      margin-bottom: 0.5rem;
    }

    ul {
      display: flex;
      gap: 1rem;
    }

    li,
    a {
      width: 100%;
    }
  }
{% endstylesheet %}
