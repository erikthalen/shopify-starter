{% doc %}
  Outputs the price of a variant, or of a product's selected or first available variant.
  Shows both the sale price and the original compare-at price (struck through) when on sale.
  Pass either `variant` or `product`. `variant` wins when both are passed.

  @param {object} [product] - Shopify `product` object. Its selected or first available variant is used.
  @param {object} [variant] - Shopify `variant` object.

  @example
  {% render 'product-price', product: product %}

  {% render 'product-price', variant: item.variant %}
{% enddoc %}

{% assign price_variant = variant | default: product.selected_or_first_available_variant %}

<div class="product-price">
  {% if price_variant.compare_at_price != blank and price_variant.compare_at_price != price_variant.price %}
    <p class="compare-price">
      <s>{{ price_variant.compare_at_price | money }}</s>
    </p>
    <p>{{ price_variant.price | money }}</p>
  {% else %}
    <p>{{ price_variant.price | money }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .product-price {
    display: flex;
    gap: 0.5rem;

    .compare-price {
      color: var(--ui-neutral-500);
    }
  }
{% endstylesheet %}
