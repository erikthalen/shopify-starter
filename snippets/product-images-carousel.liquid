{% doc %}
  Outputs the product's media in a carousel with prev/next buttons and a strip of thumbnails,
  built with [Blossom Carousel](https://www.blossom-carousel.com).
  Starts on the image of the selected first option value.
  Renders a single image when the product has less than two media.

  Uses the global `product` object — place this on product pages.

  @example
  {% render 'product-images-carousel' %}
{% enddoc %}

{% unless product.media.size < 2 %}
  {% assign first_option = product.options_with_values[0] %}
  {% assign init_slide = first_option.values | find_index: 'name', first_option.selected_value %}
  {% assign carousel_id = 'product_images_' | append: product.id %}

  {% comment %}
    hx-morph-skip: variant changes morph #main_product, which would strip the attributes
    Blossom and Alpine add at runtime. The media are the same for every variant, so leave the carousel as is.
  {% endcomment %}
  <div
    hx-morph-skip
    x-data="productImagesCarousel({{ init_slide }})"
    class="product-images"
    role="region"
    aria-label="Product images"
  >
    <div class="product-images__stage">
      <blossom-carousel
        id="{{ carousel_id }}"
        x-ref="slides"
        class="product-images__slides"
        @scroll.passive="onScroll"
      >
        {% for media in product.media %}
          <div data-blossom-slide>
            {% assign loading = 'lazy' %}
            {% if forloop.first %}
              {% assign loading = 'eager' %}
            {% endif %}
            {% if media.media_type == 'image' %}
              {% render 'image', image: media, sizes: '100vw, 50vw', aspect_ratio: '1/1', loading: loading %}
            {% elsif media.media_type == 'video' %}
              {% render 'video', video: media, aspect_ratio: '1/1' %}
            {% endif %}
          </div>
        {% endfor %}
      </blossom-carousel>

      <div class="product-images__controls">
        <button
          class="square ghost"
          type="button"
          aria-label="Previous slide"
          aria-controls="{{ carousel_id }}"
          data-placement="right"
          :disabled="activeSlide === 0"
          @click="goTo(activeSlide - 1)"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M15 6l-6 6l6 6" />
          </svg>
        </button>

        <button
          class="square ghost"
          type="button"
          aria-label="Next slide"
          aria-controls="{{ carousel_id }}"
          data-placement="left"
          :disabled="activeSlide === {{ product.media.size | minus: 1 }}"
          @click="goTo(activeSlide + 1)"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 6l6 6l-6 6" />
          </svg>
        </button>
      </div>
    </div>

    <blossom-carousel x-ref="thumbs" class="product-images__thumbs">
      {% for media in product.media %}
        <button
          type="button"
          class="ghost product-images__thumb"
          aria-label="Go to slide {{ forloop.index }}"
          aria-controls="{{ carousel_id }}"
          :aria-current="activeSlide === {{ forloop.index0 }}"
          @click="goTo({{ forloop.index0 }})"
        >
          {% if media.media_type == 'image' %}
            {% render 'image', image: media, sizes: '100vw, 50vw', aspect_ratio: '1/1' %}
          {% elsif media.media_type == 'video' %}
            {% render 'video', video: media, aspect_ratio: '1/1' %}
          {% endif %}
        </button>
      {% endfor %}
    </blossom-carousel>
  </div>
{% else %}
  {% render 'image', image: product.featured_image, sizes: '100vw, 50vw', aspect_ratio: '1/1' %}
{% endunless %}

{% stylesheet %}
  .product-images {
    --thumb-size: 10%;
    --thumbs-gap: 1rem;
  }

  .product-images__stage {
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    border-bottom-right-radius: 0.25rem;
    overflow: clip;
  }

  .product-images__slides {
    position: relative;
    grid-area: 1 / 1;
    display: flex;
    scroll-snap-type: x mandatory;

    & > * {
      flex: 0 0 100%;
      min-width: 0;
      scroll-snap-align: start;
    }
  }

  .product-images__controls {
    position: relative;
    z-index: 1;
    grid-area: 1 / 1;
    align-self: center;
    display: flex;
    justify-content: space-between;
    width: 100%;
    padding-inline: 1rem;
    color: oklch(44.6% 0.03 256.802);
    pointer-events: none;

    & button {
      pointer-events: auto;
    }
  }

  .product-images__thumbs {
    position: relative;
    display: flex;
    gap: var(--thumbs-gap);
    margin-top: var(--thumbs-gap);
    padding: 1px var(--thumbs-gap);
  }

  .product-images__thumb {
    flex: 0 0 var(--thumb-size);
    display: flex;
    padding: 0;

    &[aria-current='true'] {
      outline: 1px solid var(--jazz-neutral-700);
    }
  }
{% endstylesheet %}
