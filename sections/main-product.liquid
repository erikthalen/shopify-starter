<section id="main_product" class="main-product">
  <div class="main-product__layout">
    <div class="main-product__media">
      <blossom-carousel id="product-media-carousel" class="main-product__carousel">
        {% for media in product.media %}
          <div class="main-product__slide" data-blossom-slide>
            {% render 'media', media: media %}
          </div>
        {% endfor %}
      </blossom-carousel>

      <div class="main-product-carousel-nav">
        <blossom-prev for="product-media-carousel"></blossom-prev>
        <blossom-dots for="product-media-carousel"></blossom-dots>
        <blossom-next for="product-media-carousel"></blossom-next>
      </div>
    </div>

    <div id="product_content" class="main-product__info">
      <div id="product_info">
        <h1>{{ product.title }}</h1>

        {% render 'product-price', product: product %}
      </div>

      {% render 'product-form', product: product %}

      {%- unless product.description == '<p></p>' -%}
        <details id="product_description">
          <summary>Description</summary>

          <div>{{ product.description }}</div>
        </details>
      {%- endunless -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .main-product {
    display: grid;
    gap: 1rem;

    @media (width >= 48rem) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* snap points make prev/next move one slide, without them Blossom scrolls 85% of the width */
  .main-product__carousel {
    scroll-snap-type: x mandatory;
  }

  .main-product__slide {
    width: 100%;
    scroll-snap-align: start;
  }

  .main-product-carousel-nav {
    display: flex;
    justify-content: space-between;
  }

  .main-product__layout {
    display: grid;
    grid-column: span 2;
    align-items: start;
    justify-items: center;
    gap: 1rem;

    @media (width >= 48rem) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .main-product__media {
    width: 100%;
  }

  .main-product__variant-images {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    padding-left: 1rem;
  }

  .main-product__info {
    width: 100%;
    padding: 1.25rem;

    @media (width < 48rem) {
      padding-inline: 1rem;
    }

    @media (width >= 48rem) {
      width: 24rem;
    }

    @media (width >= 64rem) {
      position: sticky;
      top: 20vh;
    }

    & h1 {
      margin-bottom: 0.25rem;
    }

    & #product_price {
      margin-bottom: 1rem;
    }

    & details {
      margin-top: 1rem;
    }

    & summary {
      padding-block: 1rem;
      cursor: pointer;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Main product",
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Main product"
    }
  ]
}
{% endschema %}
