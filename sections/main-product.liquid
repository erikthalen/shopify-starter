{% assign variant = product.selected_or_first_available_variant %}

<div class="product-gallery">
  {% if product.media.size > 1 %}
    <blossom-carousel id="product-media-carousel">
      {% for media in product.media %}
        <div class="gallery-slide" data-blossom-slide>
          {% render 'media', media: media, sizes: '100vw, 50vw' %}
        </div>
      {% endfor %}
    </blossom-carousel>

    <div class="carousel-nav">
      <blossom-prev for="product-media-carousel">
        {% render 'icon', name: 'chevron-left' %}
      </blossom-prev>

      <blossom-next for="product-media-carousel">
        {% render 'icon', name: 'chevron-right' %}
      </blossom-next>
    </div>

    <blossom-dots for="product-media-carousel"></blossom-dots>
  {% else %}
    {% render 'media', media: product.featured_media, sizes: '100vw, 50vw' %}
  {% endif %}
</div>

<div id="product_content" class="product-info">
  <hgroup>
    <h1>{{ product.title }}</h1>

    {% render 'product-price', product: product %}
  </hgroup>

  {%- unless product.description == '<p></p>' -%}
    <div class="prose">{{ product.description }}</div>
  {%- endunless -%}

  {% unless product.has_only_default_variant %}
    <section id="variant_picker" class="variant-picker">
      {%- for option in product.options_with_values -%}
        <fieldset>
          <legend>{{ option.name }}</legend>

          <div class="tab-links morph">
            {%- for option_value in option.values -%}
              {% assign variants = product.variants %}

              {% comment %} get url to this option's variant, given what's selected of the other options {% endcomment %}
              {%- for other_option in product.options_with_values -%}
                {% if other_option.name == option.name %}
                  {% assign option_key = 'option' | append: option.position %}
                  {% assign variants = variants | where: option_key, option_value.name %}
                {% else %}
                  {% assign option_key = 'option' | append: other_option.position %}
                  {% assign variants = variants | where: option_key, other_option.selected_value %}
                {% endif %}
              {% endfor %}

              {% comment %} class="{% if option_value.selected %}secondary{% else %}outlined{% endif %}" {% endcomment %}
              <a
                hx-preload="htmx:after:init timeout:60s"
                hx-get="{{ product.url }}?variant={{ variants.first.id }}"
                hx-target="#product_content"
                hx-select="#product_content"
                hx-swap="outerMorph"
                hx-replace-url="true"
                href="{{ product.url }}?variant={{ variants.first.id }}"
                data-loading-states
                {% if option_value.selected %}
                  aria-current="page"
                {% endif %}
                {% unless option_value.available %}
                  disabled="true"
                {% endunless %}
              >
                {{ option_value -}}
              </a>
            {%- endfor -%}
          </div>
        </fieldset>
      {%- endfor -%}
    </section>
  {% endunless %}

  {% form 'product',
    product,
    class: 'product-form',
    hx-post: routes.cart_add_url,
    hx-swap: 'none',
    hx-select-oob: '#cart_drawer:outerMorph transition:true,#cart_section:outerHTML transition:true',
    data-loading-states: ''
  %}
    <input id="variant_id" type="hidden" name="id" value="{{ variant.id }}">

    <fieldset>
      {% comment %} {% assign amount_in_cart = cart.items | where: 'id', product.selected_or_first_available_variant.id | map: 'quantity' | sum %} {% endcomment %}

      {% render 'quantity-selector', min: 1, name: 'quantity', value: 1, id: 'product', attr: 'hx-preserve' %}

      <button
        class="add-to-cart"
        data-loading-aria-busy
        type="submit"
        name="add"
        {% unless variant.available %}
          disabled
        {% endunless %}
      >
        {% if variant.available %}
          Add to cart
        {% else %}
          Notify me
        {% endif %}
      </button>
    </fieldset>

    <div id="shopify_payment_button">
      {{ form | payment_button }}
    </div>
  {% endform %}

  {% comment %} {% render 'product-form', product: product %} {% endcomment %}
</div>

{% stylesheet %}
  .main-product {
    display: grid;
    align-items: start;
    justify-items: center;
    gap: 1rem;

    @media (width >= 48rem) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .product-gallery {
      isolation: isolate;

      width: 100%;
      display: grid;
      gap: 0.5rem;
      align-items: center;

      /* snap points make prev/next move one slide, without them Blossom scrolls 85% of the width */
      blossom-carousel {
        scroll-snap-type: x mandatory;
        grid-area: 1 / 1 / 1;
      }

      blossom-dots {
        button {
          min-width: auto;
        }
      }

      .gallery-slide {
        width: 100%;
        scroll-snap-align: start;
      }

      .carousel-nav {
        grid-area: 1 / 1 / 1;

        display: flex;
        justify-content: space-between;
        z-index: 1;

        padding-inline: 1rem;

        button {
          padding: 0.5rem;
          color: var(--ui-neutral-950);
          background-color: var(--ui-neutral-100);
        }
      }
    }

    .product-info {
      width: 100%;
      padding: 1.25rem 1rem;

      @media (width >= 48rem) {
        width: 24rem;
        padding-inline: 1.25rem;
      }

      @media (width >= 64rem) {
        position: sticky;
        top: 20vh;
      }

      hgroup {
        margin-bottom: 1rem;

        h1 {
          margin-bottom: 0.25rem;
        }
      }

      .variant-picker {
        display: grid;
        gap: 1rem;
        margin-block: 1rem;

        ul {
          display: flex;
          gap: 1rem;
        }

        li,
        a {
          width: 100%;
        }
      }

      .product-form {
        fieldset {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 1rem;
          margin-block: 1.5rem;
        }
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Main product",
  "tag": "section",
  "class": "main-product",
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Main product"
    }
  ]
}
{% endschema %}
