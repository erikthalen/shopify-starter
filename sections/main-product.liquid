<section id="main_product" class="main-product">
  <div class="main-product__layout">
    <div class="main-product__media">
      {% render 'product-images-carousel' %}

      {% comment %}
        <div class="main-product__variant-images">
          {% render 'variant-images' %}
        </div>
      {% endcomment %}
    </div>

    <div class="main-product__info">
      <div id="product_info">
        <h1>{{ product.title }}</h1>

        <div id="product_price">
          {% render 'product-price', product: product %}
        </div>
      </div>

      {% render 'product-form', product: product %}

      {%- unless product.description == '<p></p>' -%}
        <details id="product_description">
          <summary>Description</summary>

          <div>{{ product.description }}</div>
        </details>
      {%- endunless -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .main-product {
    display: grid;
    gap: 1rem;

    @media (width >= 48rem) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .main-product__layout {
    display: grid;
    grid-column: span 2;
    align-items: start;
    justify-items: center;
    gap: 1rem;

    @media (width >= 48rem) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .main-product__media {
    width: 100%;
  }

  .main-product__variant-images {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    padding-left: 1rem;
  }

  .main-product__info {
    width: 100%;
    padding: 1.25rem;

    @media (width < 48rem) {
      padding-inline: 1rem;
    }

    @media (width >= 48rem) {
      width: 24rem;
    }

    @media (width >= 64rem) {
      position: sticky;
      top: 20vh;
    }

    & h1 {
      margin-bottom: 0.25rem;
    }

    & #product_price {
      margin-bottom: 1rem;
    }

    & details {
      margin-top: 1rem;
    }

    & summary {
      padding-block: 1rem;
      cursor: pointer;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Main product",
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Main product"
    }
  ]
}
{% endschema %}
