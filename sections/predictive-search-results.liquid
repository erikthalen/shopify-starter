<section id="predictive-search-results">
  {%- if predictive_search.resources.products.size > 0 -%}
    <span>
      Results for: "{{ predictive_search.terms }}"
      <span class="predictive-search-results__count">({{ predictive_search.resources.products.size }})</span>
    </span>

    <ul class="predictive-search-results__list">
      {%- for product in predictive_search.resources.products -%}
        <li>
          <a href="{{ product.url }}" class="predictive-search-results__item">
            {%- if product.selected_or_first_available_variant.featured_image != blank -%}
              {%- assign image = product.selected_or_first_available_variant.featured_image -%}
            {%- else -%}
              {%- assign image = product.featured_image -%}
            {%- endif -%}

            {% render 'image',
              image: image,
              class: 'predictive-search-results__image',
              loading: 'eager',
              sizes: '100px, 100px'
            %}

            <div class="predictive-search-results__details">
              <span>{{ product.title }}</span>

              <dl>
                {%- for option in product.options_with_values -%}
                  <dt>{{ option.name }}:</dt>
                  <dd>{{ option.selected_value }}</dd>
                {%- endfor -%}
              </dl>

              <span class="predictive-search-results__price">{{ product.price | money }}</span>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {% else %}
    <div class="empty">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="icon icon-tabler icons-tabler-outline icon-tabler-forbid-2"
      >
        <path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" /><path d="M9 15l6 -6" />
      </svg>

      <h2>No results for "{{ predictive_search.terms }}"</h2>
      <p>Try searching for something else</p>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .predictive-search-results__count {
    color: oklch(55.6% 0 0);
  }

  .predictive-search-results__list {
    display: grid;
    column-gap: 1rem;

    @media (width >= 64rem) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .predictive-search-results__item {
    display: flex;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid oklch(87.2% 0.01 258.338);
  }

  .predictive-search-results__image {
    align-self: start;
    width: 5rem;
    border-radius: 0.25rem;
    overflow: clip;
  }

  .predictive-search-results__details {
    display: flex;
    flex-direction: column;

    & dl {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 0.5rem;
      margin-top: 0.25rem;
    }
  }

  .predictive-search-results__price {
    margin-top: auto;
    padding-top: 0.5rem;
  }
{% endstylesheet %}
