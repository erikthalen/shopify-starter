{% if section.settings.text != blank %}
  <div id="announcement_bar" role="region">
    {{ section.settings.text }}
  </div>
{% endif %}

{% stylesheet %}
  .announcement-bar {
    z-index: 1000;

    position: sticky;
    top: calc(var(--announcement-bar-height) * -1);

    display: flex;
    align-items: center;
    justify-content: center;

    height: var(--announcement-bar-height);
    padding-inline: 1rem;

    background-color: var(--ui-neutral-100);

    /* on the root, not the inner div, so the background moves with the text, above the page */
    view-transition-name: announcement-bar;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "class": "announcement-bar",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Announcement"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
