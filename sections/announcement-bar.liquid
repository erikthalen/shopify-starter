{% if section.settings.text != blank %}
  <div
    id="announcement_bar"
    role="region"
    style="view-transition-name: announcement-bar"
  >
    {{ section.settings.text }}
  </div>
{% endif %}

{% stylesheet %}
  body {
    --announcement-bar-height: 0rem;

    &:has(#announcement_bar) {
      --announcement-bar-height: 2.5rem;
    }
  }

  .announcement-bar {
    position: sticky;
    top: calc(var(--announcement-bar-height) * -1);
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--announcement-bar-height);
    padding-inline: 1rem;
    background-color: var(--ui-neutral-100);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "class": "announcement-bar",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Announcement"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
