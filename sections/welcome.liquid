<section class="empty welcome">
  <img class="welcome__logo" src="{{ 'shopify-logo.webp' | asset_url }}" width="100" height="100">

  <h1>Shopify starter</h1>

  <p>Using Alpine and Htmx</p>

  <a class="button ghost" href="https://github.com/erikthalen/shopify-starter" target="_blank">
    {% render 'icon', name: 'github' %}

    GitHub
  </a>
</section>

{% stylesheet %}
  .welcome {
    margin-top: 15vh;
  }

  .welcome__logo {
    width: 2rem;
    height: 2rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Welcome",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Delete me before you start"
    }
  ],
  "presets": [
    {
      "name": "Welcome"
    }
  ]
}
{% endschema %}
