<div id="main_collection">
  <div class="collection-heading">
    <h1>
      {{ collection.title }}
      <span class="product-count">({{ collection.all_products_count }})</span>
    </h1>

    {% content_for 'block', type: '_collection-filter', id: 'collection_filter' %}
  </div>

  <div id="filter_result">
    {% paginate collection.products by 12 %}
      {% if collection.products.size == 0 %}
        <p>No results</p>
      {% else %}
        <div class="product-grid">
          <ul id="paginated_items">
            {% for product in collection.products %}
              <li>
                {% render 'product-card', product: product %}
              </li>
            {% endfor %}
          </ul>

          {%- if section.settings.pagination_type == 'infinite_scroll' -%}
            {% render 'infinite-scroll', paginate: paginate %}
          {%- endif -%}
        </div>
      {% endif %}

      {%- if section.settings.pagination_type == 'pagination' -%}
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {% endpaginate %}
  </div>
</div>

{% stylesheet %}
  .main-collection {
    margin-block: 1rem;
    padding-inline: 1rem;

    .collection-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;

      .product-count {
        color: var(--ui-neutral-500);
      }
    }

    .product-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem 1rem;

      @media (width >= 48rem) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      > ul {
        display: contents;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Main collection",
  "tag": "section",
  "class": "main-collection",
  "settings": [
    {
      "type": "select",
      "id": "pagination_type",
      "label": "Pagination type",
      "options": [
        { "label": "Infinite scroll", "value": "infinite_scroll" },
        { "label": "Pagination", "value": "pagination" }
      ],
      "default": "infinite_scroll"
    }
  ]
}
{% endschema %}
