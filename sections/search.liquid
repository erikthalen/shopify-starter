<div class="search-box">
  <form
    action="{{ routes.search_url }}"
    hx-get="{{ routes.search_url }}"
    hx-trigger="submit, input delay:250ms"
    hx-select="#search_results"
    hx-target="#search_results"
    hx-swap="outerHTML transition:true"
    hx-replace-url="true"
    hx-sync="this:replace"
    data-loading-states
    data-loading-target="#search_input"
    data-loading-aria-busy
  >
    <label>
      {% render 'icon', name: 'magnifier', attr: 'data-prefix' %}

      <input
        id="search_input"
        type="text"
        placeholder="Search products and pages"
        autofocus
        name="q"
        value="{{ search.terms }}"
      >

      {% comment %}
        Not a type="reset": that would restore the prefilled terms. The input event runs the form's search trigger
      {% endcomment %}
      <button
        type="button"
        data-suffix
        class="clear-search button square ghost"
        aria-label="Clear search"
        onclick="const input = this.form.elements.q; input.value = ''; input.focus(); input.dispatchEvent(new Event('input', { bubbles: true }))"
      >
        {% render 'icon', name: 'cross' %}
      </button>

      <button data-suffix class="button">Search</button>
    </label>
  </form>
</div>

{% unless search.performed %}
  <section id="search_results" class="empty">
    {% render 'icon', name: 'magnifier' %}

    <h1>Search isn't performed</h1>
    <p>Type something in the search field.</p>
  </section>

{% else %}
  <section id="search_results" class="search-results">
    {% if search.results_count == 0 %}
      <div class="empty">
        {% render 'icon', name: 'forbid' %}

        <h1>No results for "{{ search.terms }}"</h1>
        <p>Try searching for something else</p>
      </div>
    {% else %}
      {% paginate search.results by 24 %}
        <div class="results-heading">
          <h1>
            Results for: "{{ search.terms }}"
            <span class="result-count">({{ search.results_count }})</span>
          </h1>

          <div class="result-sort">
            {%- assign current_sort_label = 'Sort by' -%}
            {%- for option in search.sort_options -%}
              {%- if search.sort_by == option.value -%}
                {%- assign current_sort_label = option.name -%}
              {%- endif -%}
            {%- endfor -%}

            <label
              class="field"
              data-loading-states
              data-loading-aria-busy
              data-loading-target="#search_sort_by_button"
            >
              <span>Sort by:</span>

              <button id="search_sort_by_button" popovertarget="sort_by_select">
                <span>{{ current_sort_label }}</span>
                {% render 'icon', name: 'chevron-down' %}
              </button>

              <div
                id="sort_by_select"
                popover
                onchange="
                  document.querySelector(`[popovertarget=${this.id}] span`).textContent =
                    event.target.closest('label').textContent.trim();
                  this.hidePopover();
                "
              >
                <menu>
                  {%- for option in search.sort_options -%}
                    <li>
                      <label>
                        <input
                          type="radio"
                          name="sort_by"
                          value="{{ option.value }}"
                          hx-get="{{ request.path }}?q={{ search.terms }}&sort_by={{ option.value }}"
                          hx-target="#search_results"
                          hx-select="#search_results"
                          hx-swap="outerHTML transition:true"
                          hx-replace-url="true"
                          {% if search.sort_by == option.value %}
                            checked
                          {% endif %}
                        >
                        {{- option.name -}}
                      </label>
                    </li>
                  {%- endfor -%}
                </menu>
              </div>
            </label>
          </div>
        </div>

        {% content_for 'block', type: '_search-filter', id: 'search-filter' %}

        <ol id="paginated_items" class="result-list">
          {%- for item in search.results -%}
            <li>
              {%- case item.object_type -%}
                {%- when 'product' -%}
                  {% render 'product-card', product: item %}
                {%- when 'article' -%}
                  <a href="{{ item.url }}">{{ item.title | truncate: 50 | escape }}</a>
                {%- when 'page' -%}
                  <a href="{{ item.url }}">{{ item.title | truncate: 50 | escape }}</a>
              {%- endcase -%}
            </li>
          {%- endfor -%}

          {%- if section.settings.pagination_type == 'infinite_scroll' -%}
            {% render 'infinite-scroll', paginate: paginate %}
          {%- endif -%}
        </ol>

        {%- if section.settings.pagination_type == 'pagination' -%}
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {% endpaginate %}
    {% endif %}
  </section>
{% endunless %}

{% stylesheet %}
  .main-search {
    .search-box {
      display: flex;
      justify-content: center;

      form {
        display: flex;
        align-items: center;
        gap: 0.5rem;

        width: 100%;
        max-width: 28rem;
        margin: 1rem 1rem 1.5rem;

        label {
          width: 100%;
          padding-block: 0.5rem;

          &:has(input:placeholder-shown) .clear-search {
            display: none;
          }
        }
      }
    }

    .search-results {
      padding: 1rem;

      .results-heading {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;

        .result-count {
          color: var(--ui-neutral-500);
        }

        .result-sort {
          display: grid;
          justify-items: end;

          > .field {
            text-align: right;
          }
        }
      }

      .result-list {
        display: grid;
        gap: 1rem;

        @media (width >= 48rem) {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Main search",
  "class": "main-search",
  "settings": [
    {
      "type": "select",
      "id": "pagination_type",
      "label": "Pagination type",
      "options": [
        { "label": "Infinite scroll", "value": "infinite_scroll" },
        { "label": "Pagination", "value": "pagination" }
      ],
      "default": "infinite_scroll"
    }
  ]
}
{% endschema %}
