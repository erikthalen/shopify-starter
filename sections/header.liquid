<div
  class="site-header"
  style="view-transition-name: site-header"
>
  <nav>
    <a
      href="{{ routes.root_url }}"
      x-data="{ active: {% if request.path == '{{ routes.root_url }}' %}true{% else %}false{% endif %} }"
      @window:navigation.window="active = $el.href.replace(location.origin, '') === location.pathname"
      :aria-current="active ? 'page' : false"
      class="button ghost"
    >
      {% if shop.brand.logo != blank %}
        {% render 'image', image: shop.brand.logo, class: 'site-header__logo', alt: 'The logo' %}
      {% else %}
        Home
      {% endif %}
    </a>

    <a
      href="{{ routes.collections_url }}"
      x-data="{ active: {% if request.path contains '{{ routes.collections_url }}' %}true{% else %}false{% endif %} }"
      @window:navigation.window="active = location.pathname.includes($el.href.replace(location.origin, ''))"
      :aria-current="active ? 'page' : false"
      class="desktop-only button ghost"
    >
      Shop
    </a>
  </nav>

  <div class="mobile-only">
    {% content_for 'block', type: '_mobile-menu', id: 'mobile_menu' %}
  </div>

  <nav>
    {% content_for 'blocks' %}
  </nav>
</div>

{% stylesheet %}
  :root {
    --header-height: 2.5rem;
  }

  .site-header {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    height: var(--header-height);
    padding-inline: 1rem;
    border-bottom: 1px solid var(--jazz-neutral-300);
    background-color: var(--jazz-background-color);

    & > nav {
      display: flex;
      align-items: center;
      gap: 0.75rem;

      &:last-child {
        margin-inline-start: auto;
      }
    }

    @media (width >= 48rem) {
      &,
      & > nav {
        gap: 1rem;
      }
    }
  }

  .site-header__logo {
    width: auto;
    height: 1.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "tag": "header",
  "enabled_on": {
    "groups": ["header"]
  },
  "limit": 1,
  "blocks": [
    {
      "type": "_localization-form"
    },
    {
      "type": "_cart-drawer"
    },
    {
      "type": "_predictive-search"
    },
    {
      "type": "_account-link"
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        {
          "type": "_localization-form"
        },
        {
          "type": "_predictive-search"
        },
        {
          "type": "_account-link"
        },
        {
          "type": "_cart-drawer"
        }
      ]
    }
  ]
}
{% endschema %}
