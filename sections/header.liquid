<nav>
  {% if shop.brand.logo != blank %}
    <a
      href="{{ routes.root_url }}"
      class="home-link"
      {% if request.path == routes.root_url %}
        aria-current="page"
      {% endif %}
    >
      <span class="sr-only">Home</span>
      {% render 'image', image: shop.brand.logo, alt: 'The logo', sizes: '40px, 40px' %}
    </a>
  {% else %}
    <a
      href="{{ routes.root_url }}"
      class="button ghost"
      {% if request.path == routes.root_url %}
        aria-current="page"
      {% endif %}
    >
      Home
    </a>
  {% endif %}

  {% for link in section.settings.main_menu.links %}
    <a
      href="{{ link.url }}"
      class="desktop-only button ghost"
      {% if link.current %}
        aria-current="page"
      {% endif %}
      {% if link.active %}
        aria-current="true"
      {% endif %}
    >
      {{ link.title }}
    </a>
  {% endfor %}
</nav>

<div class="mobile-only">
  {% render 'mobile-menu', menu: section.settings.main_menu %}
</div>

<nav>
  <span class="desktop-only">{% render 'account-link' %}</span>

  {% content_for 'blocks' %}

  {% render 'localization-form' %}

  {% render 'cart-drawer' %}
</nav>

{% stylesheet %}
  .site-header {
    z-index: 1;

    position: sticky;
    top: 0;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;

    width: 100%;
    height: var(--header-height);
    padding-inline: 1rem;

    background-color: var(--ui-background-color);
    /* a shadow, not a border, so the line sits below the header height instead of inside it */
    box-shadow: 0 1px var(--ui-neutral-300);

    view-transition-name: site-header;

    @media (width >= 48rem) {
      gap: 1rem;
    }

    > nav {
      display: flex;
      align-items: center;

      @media (width >= 48rem) {
        gap: 1rem;
      }

      &:last-child {
        margin-inline-start: auto;
      }
    }

    .home-link {
      display: flex;
      height: var(--header-height);
      padding: 0.25rem;

      img {
        height: 100%;
        aspect-ratio: 1;
        object-fit: contain;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "class": "site-header",
  "tag": "header",
  "enabled_on": {
    "groups": ["header"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Main menu"
    }
  ],
  "blocks": [
    {
      "type": "_predictive-search"
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        {
          "type": "_predictive-search"
        }
      ]
    }
  ]
}
{% endschema %}
