<div>
  <nav>
    <a
      href="{{ routes.root_url }}"
      class="home-link button ghost square"
      {% if request.path == routes.root_url %}
        aria-current="page"
      {% endif %}
    >
      {% if shop.brand.logo != blank %}
        {% render 'image', image: shop.brand.logo, alt: 'The logo', sizes: '40px, 40px' %}
      {% else %}
        Home
      {% endif %}
    </a>

    <a
      href="{{ routes.collections_url }}"
      class="desktop-only button ghost"
      {% if request.path contains routes.collections_url %}
        aria-current="page"
      {% endif %}
    >
      Shop
    </a>
  </nav>

  <div class="mobile-only">
    {% content_for 'block', type: '_mobile-menu', id: 'mobile_menu' %}
  </div>

  <nav>
    {% content_for 'blocks' %}
  </nav>
</div>

{% stylesheet %}
  :root {
    --header-height: 2.5rem;
  }

  .site-header {
    width: 100%;
    height: var(--header-height);
    background-color: var(--ui-background-color);

    position: sticky;
    top: 0;
    z-index: 1;

    view-transition-name: site-header;

    > div {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding-inline: 1rem;
      border-bottom: 1px solid var(--ui-neutral-300);

      & > nav {
        display: flex;
        align-items: center;
        gap: 0.75rem;

        &:last-child {
          margin-inline-start: auto;
        }
      }

      @media (width >= 48rem) {
        &,
        & > nav {
          gap: 1rem;
        }
      }
    }

    .home-link {
      display: flex;
      height: var(--header-height);

      img {
        aspect-ratio: 1;
        height: 100%;
        object-fit: contain;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "class": "site-header",
  "tag": "header",
  "enabled_on": {
    "groups": ["header"]
  },
  "limit": 1,
  "blocks": [
    {
      "type": "_localization-form"
    },
    {
      "type": "_cart-drawer"
    },
    {
      "type": "_predictive-search"
    },
    {
      "type": "_account-link"
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        {
          "type": "_localization-form"
        },
        {
          "type": "_predictive-search"
        },
        {
          "type": "_account-link"
        },
        {
          "type": "_cart-drawer"
        }
      ]
    }
  ]
}
{% endschema %}
